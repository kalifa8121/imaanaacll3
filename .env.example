# Neon Database URL
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Metered TURN Server (DIRQAMA Mobile Data irratti akka hojjetuuf)
# Dashboard -> TURN Server & SFU -> Credentials irraa argatta
TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=your_metered_username
TURN_CREDENTIAL=your_metered_password

# Filannoo: Metered API Key (yoo TURN_URL hin jiraanne)
# METERED_API_KEY=your_metered_api_key
