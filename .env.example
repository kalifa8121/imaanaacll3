# Neon Database URL (sslmode=require fi kkf of keessatti qabata)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Metered.ca TURN (API Key fayyadamuun credentials akka ofiin qindeessuuf)
# Metered dashboard irraa API Key argachuu dandeessa
METERED_API_KEY=your_metered_api_key_here

# Yoo TURN static qofa fayyadamuu barbaadde (METERED_API_KEY hin barbaachisu)
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_password
